#!/bin/sh
case $BUTTON in
	1|3) setsid -f "${TERMINAL:-ghostty}" -e nmtui ;;
esac

ssid=$(nmcli -t -f active,ssid dev wifi 2>/dev/null | awk -F: '$1 == "yes" { print $2; exit }')
eth_state=$(cat /sys/class/net/e*/operstate 2>/dev/null | head -n 1)

if [ "$eth_state" = "up" ]; then
	echo "Ethernet"
elif [ -n "$ssid" ]; then
	echo "Wifi: $ssid"
elif [ "$(nmcli radio wifi 2>/dev/null)" = "disabled" ]; then
	echo "Wifi Disabled"
else
	echo "Not Connected"
fi
