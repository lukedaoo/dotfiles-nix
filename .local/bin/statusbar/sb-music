#!/bin/sh
# Music block for dwmblocks (signal 30). mpd only, via mpc (no playerctl / browsers).
#   left click:  switch between "title" and "artist - title"
#   right click: play/pause
# sb-music-loop refreshes this block as soon as mpd changes state.

SIGNAL=30
FORMAT_FILE="${XDG_RUNTIME_DIR:-/tmp}/sb-music-format"

pgrep -x -u "$USER" sb-music-loop > /dev/null || setsid -f sb-music-loop > /dev/null 2>&1

case $BUTTON in
    1) [ "$(cat "$FORMAT_FILE" 2>/dev/null)" = 1 ] && echo 0 > "$FORMAT_FILE" || echo 1 > "$FORMAT_FILE" ;;
    3) mpc -q toggle ;;
esac

# mpd not running -> idle
state=$(mpc status 2>/dev/null | sed -n 's/^\[\(playing\|paused\)\].*/\1/p')
case $state in
    playing) indicator="(playing) " ;;
    paused)  indicator="(pause) " ;;
    *)       echo "(idle)"; exit 0 ;;
esac

title=$(mpc --format '%title%' current 2>/dev/null)
artist=$(mpc --format '%artist%' current 2>/dev/null)
# No tags: use the file name without path and extension.
if [ -z "$title" ]; then
    title=$(mpc --format '%file%' current 2>/dev/null | sed 's#.*/##; s/\.[^.]*$//')
    artist=
fi

short() { printf '%.10s' "$1"; }
if [ "$(cat "$FORMAT_FILE" 2>/dev/null)" = 1 ] && [ -n "$artist" ]; then
    info="$(short "$artist") - $(short "$title")"
else
    info=$(short "$title")
fi

echo "$indicator$info"
