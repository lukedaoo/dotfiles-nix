#!/bin/sh

case $BUTTON in
	1|3) setsid -f "${TERMINAL:-ghostty}" -e nmtui ;;
	2) notify-send "Internet module" "Click to connect
Wifi off: wifi disabled
Wifi none: no wifi connection
Wifi N%: wifi connection with quality
Ethernet: ethernet working
VPN: vpn is active
" ;;
esac

# Wifi
wifi=""
if [ "$(cat /sys/class/net/w*/operstate 2>/dev/null)" = 'up' ] ; then
	wifi="$(awk '/^\s*w/ { print "Wifi " int($3 * 100 / 70) "%" }' /proc/net/wireless)"
elif [ "$(cat /sys/class/net/w*/operstate 2>/dev/null)" = 'down' ] ; then
	[ "$(cat /sys/class/net/w*/flags 2>/dev/null)" = '0x1003' ] && wifi="Wifi none" || wifi="Wifi off"
fi

# Ethernet
[ "$(cat /sys/class/net/e*/operstate 2>/dev/null)" = 'up' ] && eth="Ethernet"

# TUN
[ -n "$(cat /sys/class/net/tun*/operstate 2>/dev/null)" ] && vpn="VPN"

echo "$wifi${eth:+ $eth}${vpn:+ $vpn}" | sed 's/^ //'
