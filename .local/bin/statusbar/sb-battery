#!/bin/sh

LOW=15
REPEAT=5
STATE="${XDG_RUNTIME_DIR:-/tmp}/sb-battery-low"   # time of the last warning

bat=
for d in /sys/class/power_supply/*; do
    [ "$(cat "$d/type" 2>/dev/null)" = Battery ] && { bat=$d; break; }
done
[ -n "$bat" ] && [ -r "$bat/capacity" ] || exit 0

capacity=$(cat "$bat/capacity")
status=$(cat "$bat/status")

case $status in
    "Not charging"|Unknown) status=Limiting ;;
esac

printf 'Bat: %s%% %s\n' "$capacity" "$status"

if [ "$status" = Discharging ] && [ "$capacity" -lt "$LOW" ]; then
    now=$(date +%s)
    last=$(cat "$STATE" 2>/dev/null || echo 0)
    if [ $((now - last)) -ge "$REPEAT" ]; then
        notify-send -u critical -a battery -h string:x-dunst-stack-tag:battery-low \
            "Battery low: $capacity%" "Plug in the charger"
        echo "$now" > "$STATE"
    fi
else
    rm -f "$STATE"
fi
