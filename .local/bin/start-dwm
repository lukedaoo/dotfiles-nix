#!/bin/sh
export _JAVA_AWT_WM_NONREPARENTING=1

#remap capslock to esc
setxkbmap -option caps:escape
xset r rate 200 65
fcitx5 &

#enable notification service
#/usr/lib/notification-daemon-1.0/notification-daemon &
dunst &

#enable alpha feautre
xcompmgr &

# playerctl with mpd
mpd &
mpDris2 &

#start layout
layout=~/.screenlayout/$(cat /etc/hostname).sh
if [ -x "$layout" ] ; then
  "$layout"
fi


#start status bar
/usr/local/bin/dwmblocks &

#start wallpaper
if [ -f ~/.fehbg ] ; then
  ~/.fehbg &
fi

if [ -z "$DBUS_SESSION_BUS_ADDRESS" ]; then
    eval $(dbus-launch --sh-syntax --exit-with-session)
fi

#fix file chooser
export XDG_CURRENT_DESKTOP=XFCE     
export QT_QPA_PLATFORMTHEME=gtk3

# Audio: on systemd (Arch) PipeWire is socket activated; without systemd (Void) start it here.
# wireplumber and pipewire-pulse are loaded by pipewire itself (see setup_audio.sh).
if [ ! -d /run/systemd/system ] && command -v pipewire > /dev/null && ! pgrep -x -u "$USER" pipewire > /dev/null; then
    pipewire &
fi

# Arch keeps the portals in /usr/lib, Void in /usr/libexec.
for portal in xdg-desktop-portal xdg-desktop-portal-gtk; do
    for dir in /usr/lib /usr/libexec; do
        if [ -x "$dir/$portal" ]; then "$dir/$portal" & break; fi
    done
done

if [ -d /run/systemd/system ]; then
    dbus-update-activation-environment --systemd --all
    systemctl --user import-environment DISPLAY XDG_CURRENT_DESKTOP
else
    dbus-update-activation-environment --all
fi

#start session
/usr/local/bin/dwm 
