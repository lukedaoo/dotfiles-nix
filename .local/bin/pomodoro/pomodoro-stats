#!/bin/bash
DIR=$(dirname "$(readlink -f "$0")")
. "$DIR/pomodoro-common"

REPORT="$CACHE/report.html"
[ -f "$SESSION" ] || { notify-send -a pomodoro "No sessions yet"; exit 0; }

rows() {
    # $1 = lower bound date (YYYY-MM-DD)
    awk -F'\t' -v since="$1" '
        $2 == "work" {
            day = strftime("%Y-%m-%d", $1)
            if (day < since) next
            secs[$5] += $3
            if ($4 == "done") n[$5]++
        }
        END {
            for (t in secs) printf "<tr><td>%s</td><td>%d</td><td>%.1f h</td></tr>\n", t, n[t], secs[t]/3600
        }' "$SESSION" | sort
}

daily() {
    awk -F'\t' '
        $2 == "work" { d[strftime("%Y-%m-%d", $1)] += $3 }
        END { for (k in d) printf "<tr><td>%s</td><td>%.1f h</td></tr>\n", k, d[k]/3600 }' "$SESSION" | sort -r | head -14
}

week=$(date -d '6 days ago' +%Y-%m-%d)
today=$(date +%Y-%m-%d)

cat > "$REPORT" <<HTML
<!doctype html><meta charset=utf-8><title>Pomodoro report</title>
<style>
body{font:15px sans-serif;max-width:640px;margin:2em auto;background:#1e1e2e;color:#cdd6f4}
table{width:100%;border-collapse:collapse;margin-bottom:2em}
td,th{padding:.4em .6em;border-bottom:1px solid #45475a;text-align:left}
</style>
<h2>Today</h2>
<table><tr><th>Title</th><th>Done</th><th>Focus</th></tr>$(rows "$today")</table>
<h2>Last 7 days</h2>
<table><tr><th>Title</th><th>Done</th><th>Focus</th></tr>$(rows "$week")</table>
<h2>Per day</h2>
<table><tr><th>Day</th><th>Focus</th></tr>$(daily)</table>
HTML

xdg-open "$REPORT" >/dev/null 2>&1
