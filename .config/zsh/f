# Define the folders to search with fzf
FZF_FOLDERS=(
  "$HOME/Desktop"
  "$HOME/Documents"
  "$HOME/Downloads"
  "$HOME/.config"
  "$HOME/.local"
  "$HOME/.runtime-lib"
  "$HOME/Work"
)

# Define subdirectories and files to ignore
FZF_IGNORE_DIRS=(
  # build / deps
  "node_modules"
  "dist"
  "build"
  "out"
  "target"
  "vendor"
  "coverage"
  ".nyc_output"
  "__pycache__"
  ".pytest_cache"
  ".mypy_cache"
  ".tox"
  # frameworks
  ".next"
  ".nuxt"
  ".gradle"
  ".android"
  ".conda"
  # vcs
  ".git"
  # venvs
  "venv"
  ".venv"
  "env"
  "site-packages"
  # lang toolchains
  ".cargo"
  ".rustup"
  ".npm"
  ".yarn"
  ".pnpm-store"
  ".go"
  "go"
  # app data / browser profiles
  ".mozilla"
  ".thunderbird"
  ".gnome"
  ".dbus"
  ".pulse"
  ".steam"
  ".wine"
  ".java"
  # large local share dirs
  ".local"
  # system / runtime
  "snap"
  "proc"
  # media
  "photos"
  "videos"
  "music"
  "Pictures"
  "Music"
  "Videos"
)

FZF_IGNORE_FILES=(
  "*.log"
  "*.zip"
  "*.tar.gz"
  "*.jpg"
  "*.png"
  "*.mp4"
  "*.pdf"
  "*.dmg"
  "*.iso"
  "*.part"
  "*.bak"
  "*.swp"
  ".DS_Store"
)

# Check if command exists
check_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Error: $1 is not installed. Please install it and try again." >&2
    return 1
  fi
}

fzf_custom() {
  # Required commands
  check_command "fzf" || return 1
  check_command "find" || return 1
  check_command "nvim" || return 1

  # Build prune expression — stops find from descending into ignored dirs
  local prune_expr=(-name "${FZF_IGNORE_DIRS[1]}")
  for dir in "${FZF_IGNORE_DIRS[@]:1}"; do
    prune_expr+=(-o -name "$dir")
  done

  # File exclusions and size filters applied only to non-pruned results
  local file_filters=(-size +100c -size -100M)
  for f in "${FZF_IGNORE_FILES[@]}"; do
    file_filters+=(-not -name "$f")
  done

  # Run fzf
  local selected_item
  selected_item=$(find "$PWD" \( "${prune_expr[@]}" \) -prune -o \
    \( -type f "${file_filters[@]}" \) -print 2>/dev/null |
    fzf --height 40% --layout reverse --border 2>/dev/null)

    # Handle selection
    if [[ -n "$selected_item" ]]; then
      if [[ -d "$selected_item" ]]; then
        echo "cd $(printf '%q' "$selected_item")"
      elif [[ -f "$selected_item" ]]; then
        echo "nvim '$selected_item'"
      fi
    fi
}

fzf_custom_widget() {
  local result
  result=$(fzf_custom)
  
  if [[ -n "$result" ]]; then
    echo "DEBUG: Evaluating command '$result'" >&2
    eval "$result"
  fi
  
  zle reset-prompt
}

zle -N fzf_custom_widget

bindkey '^F' fzf_custom_widget
