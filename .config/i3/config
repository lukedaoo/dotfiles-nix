# i3 config — ported from dwm config.h
# Place at ~/.config/i3/config

set $mod Mod4
set $alt Mod1

# ---------------------------------------------------------------------------
# appearance
# ---------------------------------------------------------------------------
font pango:Comic Code 12, Font Awesome 6 Free 12

# dwm: borderpx=1, gappx=5
default_border pixel 1
default_floating_border pixel 1
gaps inner 5
gaps outer 0
smart_gaps on

# ayu dark palette (col_gray1/2/3/4, col_cyan from your config)
set $bg      #0A0E14
set $border  #1D202F
set $fg      #F9F9F9
set $fg_sel  #CBCCC6
set $sel     #2d2c2b
set $accent  #E6B450

#                       border  backgr. text     indicator child_border
client.focused          $border $accent $bg      $accent   $border
client.focused_inactive $border $bg     $fg      $border   $border
client.unfocused        $border $bg     $fg      $border   $border
client.urgent           #900000 #900000 $fg_sel  #900000   #900000

# ---------------------------------------------------------------------------
# terminal / launcher
# ---------------------------------------------------------------------------
set $term ghostty
bindsym $mod+Return exec $term
bindsym $mod+space exec dmenu_run -m 0 -fn "Comic Mono:style=Normal:size=12" \
    -nb "$bg" -nf "$fg" -sb "$sel" -sf "$fg_sel"

# ---------------------------------------------------------------------------
# window focus / movement (dwm: focusstackvis j/k)
# ---------------------------------------------------------------------------
bindsym $mod+j focus down
bindsym $mod+k focus up

# no equivalent for focusstackhid (hidden-client stack cycling) — dropped

bindsym $mod+q kill

# ---------------------------------------------------------------------------
# resize (dwm: setmfact h/l — approximated as direct width resize)
# ---------------------------------------------------------------------------
bindsym $mod+h resize shrink width 40 px or 5 ppt
bindsym $mod+l resize grow width 40 px or 5 ppt

# incnmaster (alt+r / alt+shift+r) — no master-count concept in i3, dropped
# zoom (mod+shift+Return, swap to master) — no master area in i3, dropped

# ---------------------------------------------------------------------------
# layouts (dwm: tile/floating/monocle/centeredmaster/centeredfloatingmaster)
# ---------------------------------------------------------------------------
workspace_layout tabbed
bindsym $alt+t layout splith
bindsym $alt+space layout toggle split
bindsym $alt+f layout toggle tabbed split
bindsym $mod+Left focus left
bindsym $mod+Right focus right
# centeredmaster ($alt+u) / centeredfloatingmaster ($alt+o) — no i3 equivalent
bindsym $alt+shift+space floating toggle
bindsym $alt+F11 fullscreen toggle

bindsym $mod+Tab workspace back_and_forth

# scratchpad hide/show
bindsym $alt+h move scratchpad
bindsym $alt+s scratchpad show

# ---------------------------------------------------------------------------
# apps
# ---------------------------------------------------------------------------
bindsym $mod+e exec thunar
bindsym $mod+z exec cboomer
bindsym $mod+n exec take_note
bindsym $mod+F4 exec flameshot-fix
bindsym $mod+Print exec flameshot-fix

# ---------------------------------------------------------------------------
# monitors (dwm: focusmon/tagmon)
# ---------------------------------------------------------------------------
bindsym $mod+comma focus output left
bindsym $mod+period focus output right
bindsym $mod+shift+comma move container to output left
bindsym $mod+shift+period move container to output right

# ---------------------------------------------------------------------------
# gaps (dwm: setgaps minus/equal/shift+equal)
# ---------------------------------------------------------------------------
bindsym $mod+minus gaps inner current minus 5
bindsym $mod+equal gaps inner current plus 5
bindsym $mod+shift+equal gaps inner current set 0

# ---------------------------------------------------------------------------
# media / brightness / mic keys
# ---------------------------------------------------------------------------
bindsym XF86AudioLowerVolume exec --no-startup-id amixer set Master 5%- && pkill -RTMIN+20 i3blocks
bindsym XF86AudioRaiseVolume exec --no-startup-id amixer set Master 5%+ && pkill -RTMIN+20 i3blocks
bindsym XF86AudioMute        exec --no-startup-id amixer set Master toggle && pkill -RTMIN+20 i3blocks
bindsym XF86AudioMicMute     exec --no-startup-id amixer set Capture toggle
bindsym XF86AudioNext        exec --no-startup-id playerctl next
bindsym XF86AudioPrev        exec --no-startup-id playerctl previous
bindsym XF86AudioPlay        exec --no-startup-id playerctl play-pause
bindsym XF86MonBrightnessUp   exec --no-startup-id light -A 10
bindsym XF86MonBrightnessDown exec --no-startup-id light -U 10

# ---------------------------------------------------------------------------
# workspaces (dwm: TAGKEYS 1-9 — view/tag only; toggleview/toggletag dropped,
# they rely on dwm's multi-tag-per-client model which i3 workspaces don't have)
# ---------------------------------------------------------------------------
bindsym $alt+1 workspace number 1
bindsym $alt+2 workspace number 2
bindsym $alt+3 workspace number 3
bindsym $alt+4 workspace number 4
bindsym $alt+5 workspace number 5
bindsym $alt+6 workspace number 6
bindsym $alt+7 workspace number 7
bindsym $alt+8 workspace number 8
bindsym $alt+9 workspace number 9

bindsym $alt+shift+1 move container to workspace number 1
bindsym $alt+shift+2 move container to workspace number 2
bindsym $alt+shift+3 move container to workspace number 3
bindsym $alt+shift+4 move container to workspace number 4
bindsym $alt+shift+5 move container to workspace number 5
bindsym $alt+shift+6 move container to workspace number 6
bindsym $alt+shift+7 move container to workspace number 7
bindsym $alt+shift+8 move container to workspace number 8
bindsym $alt+shift+9 move container to workspace number 9

# ---------------------------------------------------------------------------
# quit
# ---------------------------------------------------------------------------
bindsym $mod+shift+minus exit

# ---------------------------------------------------------------------------
# mouse (dwm: MODKEY+drag move/resize on ClkClientWin)
# ---------------------------------------------------------------------------
floating_modifier $mod

# ---------------------------------------------------------------------------
# app -> workspace assignment (dwm: rules[] tag mask)
# ---------------------------------------------------------------------------
for_window [class="^Gimp$"] floating enable

assign [class="^Google-chrome$"]   workspace number 2
assign [class="^Microsoft-edge$"]  workspace number 2
assign [class="^firefox$"]         workspace number 2
assign [class="^LibreWolf$"]       workspace number 2
assign [class="^Ferdium$"]         workspace number 8
assign [class="^org.mozilla.Thunderbird$"] workspace number 7
assign [class="^jetbrains-idea-ce$"] workspace number 6
assign [class="^Slack$"]           workspace number 3
assign [class="^discord$"]         workspace number 4
assign [class="^teams-for-linux$"] workspace number 4

# ---------------------------------------------------------------------------
# bar — dwmblocks will NOT feed this; swap status_command for i3blocks/polybar
# if you're porting your existing dwmblocks scripts.
# ---------------------------------------------------------------------------
bar {
    status_command i3blocks
    position top
    font pango:Comic Code 12, Font Awesome 6 Free 12
    colors {
        background $bg
        statusline $fg
        separator  $border

        focused_workspace  $sel    $sel    $fg_sel
        active_workspace   $border $bg     $fg
        inactive_workspace $border $bg     $fg
        urgent_workspace    #900000 #900000 $fg_sel
    }
}
